import os
import cv2
import csv
import mediapipe as mp
import tkinter as tk
from tkinter import filedialog

# Initialize pose detection from MediaPipe
mp_drawing = mp.solutions.drawing_utils
mp_pose = mp.solutions.pose

# Function to apply pose tracking on an image and return pose landmarks
def apply_pose_tracking_on_image(image_path):
    with mp_pose.Pose(static_image_mode=True) as pose:
        image = cv2.imread(image_path)
        image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
        results = pose.process(image_rgb)
        
        # Return landmarks or None if no landmarks were detected
        if results.pose_landmarks:
            return results.pose_landmarks.landmark
        else:
            return None

# Function to save landmarks to a CSV file
def save_landmarks_to_csv(landmarks, csv_path):
    with open(csv_path, mode='w', newline='') as file:
        writer = csv.writer(file)
        writer.writerow(['Image_Number', 'X', 'Y', 'Z', 'Visibility'])
        for i, landmark in enumerate(landmarks):
            writer.writerow([i, landmark.x, landmark.y, landmark.z, landmark.visibility])

# Function to combine all CSV files into one
def combine_csv_files(trial_folders, output_file):
    with open(output_file, mode='w', newline='') as outfile:
        writer = csv.writer(outfile)
        writer.writerow(['Trial', 'Image_Number', 'X', 'Y', 'Z', 'Visibility'])

        for trial_folder in trial_folders:
            csv_file = os.path.join(trial_folder, f"{os.path.basename(trial_folder)}.csv")
            if os.path.exists(csv_file):
                with open(csv_file, 'r') as infile:
                    reader = csv.reader(infile)
                    next(reader)  # Skip the header row
                    for row in reader:
                        writer.writerow([os.path.basename(trial_folder)] + row)

# Main function
def main():
    # Prompt user to select the main folder
    root = tk.Tk()
    root.withdraw()  # Hide the root window
    chosen_folder = filedialog.askdirectory(title="Select the main folder")
    
    if not chosen_folder:
        print("No folder selected. Exiting...")
        return
    
    # Create the combined data folder
    combined_data_folder = os.path.join(chosen_folder, f"Complete Data for {os.path.basename(chosen_folder)}")
    os.makedirs(combined_data_folder, exist_ok=True)
    combined_csv_path = os.path.join(combined_data_folder, "combined_data.csv")

    # Iterate over trial folders
    for trial_folder in os.listdir(chosen_folder):
        trial_folder_path = os.path.join(chosen_folder, trial_folder)
        
        if os.path.isdir(trial_folder_path) and trial_folder.isdigit():
            body_folder = os.path.join(trial_folder_path, "body")
            if os.path.exists(body_folder):
                trial_csv_path = os.path.join(trial_folder_path, f"{trial_folder}.csv")
                all_landmarks = []
                
                # Process each image in the body folder
                for image_name in os.listdir(body_folder):
                    image_path = os.path.join(body_folder, image_name)
                    landmarks = apply_pose_tracking_on_image(image_path)
                    
                    if landmarks:
                        all_landmarks.extend(landmarks)
                
                # Save the landmarks to a CSV file for the current trial
                save_landmarks_to_csv(all_landmarks, trial_csv_path)
    
    # Combine all trial CSV files into one
    combine_csv_files([os.path.join(chosen_folder, folder) for folder in os.listdir(chosen_folder) if folder.isdigit()], combined_csv_path)
    print(f"All CSV files combined into: {combined_csv_path}")

if __name__ == "__main__":
    main()